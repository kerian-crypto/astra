# Copier vers infra/.env et remplacer toutes les valeurs.
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_USER=astra
POSTGRES_PASSWORD=change-me
POSTGRES_DB=astra_hub
# Port exposé sur la machine hôte (changer si 5432 est déjà pris).
POSTGRES_HOST_PORT=5432

SECRET_KEY=change-me-with-at-least-32-random-characters
ENVIRONMENT=development
# Origines autorisées (séparées par des virgules) ; vide pour l'app mobile seule.
BACKEND_CORS_ORIGINS=

# ASTRA AI — modèle local Ronda servi par llama-server (llama.cpp).
# llama-server doit écouter sur une interface joignable depuis Docker
# (ex. --host 0.0.0.0, protégé par le pare-feu), puis :
# AI_BASE_URL=http://host.docker.internal:8080
AI_BASE_URL=
